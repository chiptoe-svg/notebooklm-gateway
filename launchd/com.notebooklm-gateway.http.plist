<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.notebooklm-gateway.http</string>
  <key>WorkingDirectory</key><string>REPO_PATH</string>
  <key>ProgramArguments</key>
  <array><string>UV_PATH</string><string>run</string><string>--frozen</string><string>python</string><string>-m</string><string>nlm_gateway</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>HOME_PATH</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>HOME_PATH/Library/Logs/notebooklm-gateway.out.log</string>
  <key>StandardErrorPath</key><string>HOME_PATH/Library/Logs/notebooklm-gateway.err.log</string>
</dict>
</plist>
