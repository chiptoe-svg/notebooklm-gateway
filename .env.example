# Public base (Caddy) URL, no trailing slash
NLM_PUBLIC_BASE_URL=https://gateway.example.com/notebooklm
# Your NotebookLM tier's daily Audio Overview limit (free 3, Plus 6, Pro 20)
NLM_ACCOUNT_AUDIO_DAILY=3
# Audio overviews per day left for your own manual use
NLM_ACCOUNT_AUDIO_RESERVE=2
# Account-wide rolling-24h caps (defaults shown)
NLM_ACCOUNT_REPORT_DAILY=95
NLM_ACCOUNT_SLIDES_DAILY=10
NLM_ACCOUNT_INFOGRAPHIC_DAILY=10
NLM_ACCOUNT_CHAT_DAILY=480
# Sources per notebook for your tier (free 50, Pro 300)
NLM_NOTEBOOK_SOURCE_CAP=50
NLM_TIMEZONE=America/New_York
NLM_STATE_DIR=state
NLM_PORT=8773
